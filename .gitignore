# Your own data: app settings, chat logs, usage log, keys (Video Octopus keeps them in local/, never in git)
/local/

# Secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json

# Dependencies and build output
node_modules/
dist/
build/
out/
coverage/
__pycache__/
*.pyc

# Video, audio and renders: large, and personal
*.mp4
*.mov
*.m4v
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.m4a
*.aif
*.aiff
*.caf
*.flac
/renders/
/recordings/
/projects/

# Creator-owned studio configuration and skills belong outside the app checkout.
# Generic starter templates under starter/ remain versioned.
/preferences/
/memory/
/skills/custom/
/skills/overrides/
/.studio/
/BRAND.md
/STYLE.md

# Agents' and editors' local folders, OS files, logs
/.claude/
/.codex/
.vscode/
.idea/
.DS_Store
*.log

# Local SQLite databases and their journals are creator data.
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
